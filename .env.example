# Base URL of the HireFlow API, including the /api prefix.
# Local: http://127.0.0.1:8000/api   Production: https://api.your-domain.com/api
# If left empty, the app calls /api on its own origin (e.g. behind a reverse proxy).
VITE_API_URL=

# Show the demo-account panel on the login page. Always on in `npm run dev`;
# enable in a build only for a public demo deployment seeded with demo data.
VITE_DEMO_MODE=false
